@startuml
class Users {
  +ID : INT <<PK>>
  +FirstName : VARCHAR(50)
  +LastName : VARCHAR(50)
  +Login : VARCHAR(50)
  +Password : VARCHAR(50)
}

class Colors {
  +ID : INT <<PK>>
  +Name : VARCHAR(50)
  +UserID : INT <<FK>>
}

class "Client JS" as Client <<JavaScript>> {
  -urlBase : String
  -extension : String
  -userId : int
  -firstName : String
  -lastName : String
  +doLogin()
  +saveCookie()
  +readCookie()
  +doLogout()
  +addColor()
  +searchColor()
}

class "Login.php" as LoginAPI <<API>> {
  +getRequestInfo()
  +sendResultInfoAsJson(obj)
  +returnWithError(err)
  +returnWithInfo(firstName, lastName, id)
}

class "AddColor.php" as AddAPI <<API>> {
  +getRequestInfo()
  +sendResultInfoAsJson(obj)
  +returnWithError(err)
}

class "SearchColors.php" as SearchAPI <<API>> {
  +getRequestInfo()
  +sendResultInfoAsJson(obj)
  +returnWithError(err)
  +returnWithInfo(searchResults)
}

Users "1" -- "0..*" Colors : owns >

Client ..> LoginAPI : POST {login, password}
Client ..> AddAPI : POST {color, userId}
Client ..> SearchAPI : POST {search, userId}

LoginAPI ..> Users : reads
AddAPI ..> Colors : inserts
SearchAPI ..> Colors : reads
@enduml
